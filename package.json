{
  "name": "foot-manager",
  "version": "1.0.0",
  "description": "Jeu de gestion d'équipe de foot en ligne",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "node --watch server/index.js",
    "dev:client": "cd client && npm run dev",
    "build": "cd client && npm install --include=dev && npm run build",
    "start": "node server/index.js",
    "setup": "npm install && cd client && npm install",
    "db:seed": "node server/db/seed.js",
    "test": "node --test \"server/test/*.test.js\""
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "sql.js": "^1.10.0",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "concurrently": "^8.2.0"
  },
  "engines": {
    "node": ">=18"
  }
}
